# Copy to .env.local (local dev) and add the same values in Vercel → Project → Settings → Environment Variables.

# --- Firebase (Project settings → General → Your apps → Web app config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# Realtime Database → Data → the URL at the top
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google Cloud (same project as Firebase) ---
# APIs & Services → Credentials → OAuth 2.0 Client ID (type: Web application)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Project number (Cloud console home page). The Drive Picker needs it to grant access to picked files.
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=
# Optional: a browser API key with the Picker API enabled. Defaults to the Firebase API key.
NEXT_PUBLIC_GOOGLE_API_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# The OAuth client's secret, used to exchange sign-in codes for Drive refresh tokens.
GOOGLE_CLIENT_SECRET=
# 32+ random characters; encrypts the refresh-token cookie. e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Firebase → Project settings → Service accounts → Generate new private key; paste the JSON on one line.
FIREBASE_SERVICE_ACCOUNT=
